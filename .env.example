# copiar a ".env" (el .env esta en .gitignore y nunca se sube)
JENKINS_ADMIN_PASSWORD=cambiar-esto
REPO_URL=https://github.com/USUARIO/lifemap.git
# el dataset de yelp es publico; si tienes token de kaggle va aqui y jenkins lo toma como credencial
KAGGLE_USERNAME=
KAGGLE_KEY=
# opcional: carpeta donde ya tienes yelp-dataset.zip (4,4 GB) para no volver a bajarlo
# YELP_ZIP_DIR=C:/ruta/a/la/carpeta

# url publica estable con ngrok (cuenta gratis en ngrok.com): authtoken y dominio fijo que te asigna
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
